[core]
	autocrlf = input
	excludesfile = /Users/dat.ta/.gitignore_global
	editor = vim
	eol = lf
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[user]
	name = Joe Ta
	email = joe.vuthanh.ta@mantelgroup.vn
[pull]
	rebase = false
[alias]
	# ── Stage / unstage ──────────────────────────────────────────────────────
	a    = "!git status --short | peco | awk '{print $2}' | xargs git add"
	ua   = "!git diff --cached --name-only | peco | xargs git restore --staged"

	# ── Commit ───────────────────────────────────────────────────────────────
	ci   = commit
	cm   = commit -m
	ca   = commit --amend
	cane = commit --amend --no-edit
	undo = reset HEAD~1 --mixed

	# ── Diff ─────────────────────────────────────────────────────────────────
	d    = diff
	ds   = diff --staged
	sh   = show
	df   = "!git hist | peco | awk '{print $2}' | xargs -I {} git diff {}^ {}"

	# ── Log ──────────────────────────────────────────────────────────────────
	l    = log --oneline
	hist = log --pretty=format:\"%Cgreen%h %Creset%cd %Cblue[%cn] %Creset%s%C(yellow)%d%C(reset)\" --graph --date=relative --decorate --all
	llog = log --graph --name-status --pretty=format:\"%C(red)%h %C(reset)(%cd) %C(green)%an %Creset%s %C(yellow)%d%Creset\" --date=relative
	find = "!f() { git log --pretty=format:\"%h %cd [%cn] %s%d\" --date=relative -S'pretty' -S\"$@\" | peco | awk '{print $1}' | xargs -I {} git diff {}^ {}; }; f"

	# ── Branch ───────────────────────────────────────────────────────────────
	co   = checkout
	br   = branch
	ba   = branch -a
	bd   = branch -D
	bm   = branch --merged
	bn   = branch --no-merged
	bclean = "!git branch --merged | grep -v '\\*\\|main\\|master\\|develop' | xargs -n1 git branch -d"
	cobd = "!f() { \
    branch_name=$1; \
    current_branch=$(git symbolic-ref --short HEAD); \
    if git rev-parse --verify $branch_name >/dev/null 2>&1; then \
      git branch -D $branch_name; \
    fi; \
    git checkout -b $branch_name $current_branch; \
  }; f"

	# ── Push / pull ───────────────────────────────────────────────────────────
	ps   = "!git push origin $(git rev-parse --abbrev-ref HEAD)"
	psf  = "!git push -f origin $(git rev-parse --abbrev-ref HEAD)"
	pl   = "!git pull origin $(git rev-parse --abbrev-ref HEAD)"
	fp   = pull --rebase --autostash
	fe   = fetch --prune

	# ── Remote ───────────────────────────────────────────────────────────────
	rv   = remote -v

	# ── Rebase ───────────────────────────────────────────────────────────────
	rb   = rebase
	rbi  = rebase -i
	rbc  = rebase --continue
	rba  = rebase --abort

	# ── Stash ────────────────────────────────────────────────────────────────
	ss   = stash
	sp   = stash pop
	sl   = stash list
	sd   = stash drop

	# ── Cherry-pick ───────────────────────────────────────────────────────────
	cp   = cherry-pick
	cpc  = cherry-pick --continue
	cpa  = cherry-pick --abort

	# ── Restore / assume-unchanged ────────────────────────────────────────────
	rs          = restore
	mark-unchange  = "update-index --assume-unchanged"
	mark-change    = "update-index --no-assume-unchanged"

	# ── Misc ─────────────────────────────────────────────────────────────────
	st          = status
	quick-squash = "!f() { branch=${1:-master}; git reset --soft $(git merge-base $branch HEAD) && git commit --edit --message=\"${2:-Quick squash}\"; }; f"
	open        = "!hub browse"
	type        = cat-file -t
	dump        = cat-file -p
	edit-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; vim `f`"
	add-unmerged  = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
